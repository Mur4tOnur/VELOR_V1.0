{
  "name": "velor-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=8192 node_modules/next/dist/bin/next dev",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && node --max-old-space-size=8192 node_modules/next/dist/bin/next dev",
    "build": "node --max-old-space-size=8192 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "node --max-old-space-size=4096 node_modules/next/dist/bin/next lint"
  },
  "dependencies": {
    "@splinetool/react-spline": "^4.1.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lightweight-charts": "^5.0.3",
    "lucide-react": "^1.7.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.0"
  }
}
